  "cards": [
    {
      "dot": "cyan",
      "title": "Three processes, not one",
      "items": [
        "The listener only accepts and forks",
        "The connection process dies with the socket",
        "The session process is orphaned on purpose and keeps the shell"
      ]
    },
    {
      "dot": "rose",
      "title": "Authenticated before anything costs",
      "items": [
        "The server sends 32 random bytes and expects HMAC-SHA256 back",
        "The secret itself never crosses the wire, and a reply cannot be replayed",
        "A wrong answer never reaches forkpty, so it costs no shell"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why the shell does not freeze",
      "items": [
        "The session reads the PTY even with nobody attached",
        "Stopping would fill the kernel buffer and block bash on its next write",
        "Losing a client only sets the descriptor to -1; the shell is never signalled"
      ]
    }
  ]
